# Variables de entorno para GameControl
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitees .env.local con valores reales.

# ── Supabase (frontend / Vite) ──────────────────────────────────
# Estas variables son públicas por diseño (van en el bundle del navegador).
# Sólo deben contener la URL del proyecto y la ANON KEY.
# La SERVICE ROLE KEY NUNCA debe ir en el frontend.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Supabase (sólo edge functions / backend) ────────────────────
# Estas variables NO deben estar en ningún archivo que Vite envíe al navegador.
# Se configuran en Supabase > Edge Functions > Secrets.

# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key-aqui
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
